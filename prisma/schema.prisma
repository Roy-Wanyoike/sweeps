generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Show {
  id           String        @id @default(cuid())
  title        String
  premise      String
  genre        String        @default("drama")
  visualStyle  String        @default("cinematic")
  mode         String        @default("DUAL") // 'SINGLE' | 'DUAL' (DUAL = control arm A + treatment arm B)
  episodeCount Int           @default(3)
  budgetUsd    Float         @default(5.0)
  panelSize    Int           @default(200)
  seed         Int
  status       String        @default("SETUP") // SETUP | RUNNING | DONE
  gateOnWhatIf Boolean       @default(false) // pre-flight governance: arm-B episodes require a passing what-if dry-run first
  lore         String? // JSON: committed lore { key: value } — compiler source of truth
  createdAt    DateTime      @default(now())
  characters   Character[]
  entities     WorldEntity[]
  episodes     Episode[]
  viewers      Viewer[]
  experiments  Experiment[]
  costs        CostEntry[]
  whatIfRuns   WhatIfRun[]
}

model Character {
  id          String  @id @default(cuid())
  showId      String
  show        Show    @relation(fields: [showId], references: [id])
  name        String
  role        String
  appearance  String
  personality String
  voiceStyle  String
  refImage    String?
  attrs       String  @default("{}") // JSON structured attributes for C6-LORE
}

model WorldEntity {
  id       String  @id @default(cuid())
  showId   String
  show     Show    @relation(fields: [showId], references: [id])
  kind     String // 'LOCATION' | 'PROP'
  name     String
  desc     String
  refImage String?
}

model Episode {
  id             String     @id @default(cuid())
  showId         String
  show           Show       @relation(fields: [showId], references: [id])
  number         Int
  arm            String     @default("A") // 'A' control | 'B' treatment
  status         String     @default("DRAFT")
  // DRAFT|WRITING|COMPILING|COMPILE_FAILED|RENDERING|RENDER_PARTIAL|SCREENING|ANALYZING|DONE
  beatPlan       String? // JSON Beat[]
  compileReport  String? // JSON CompileReport
  summary        String?
  briefJson      String? // JSON WriterBrief snapshot — the exact brief the writer saw
  briefFingerprint String? // sha256 of the applied brief (null = written blind)
  adoptedFromFp  String?  // sha256 of the WhatIfRun this plan was adopted from (null = writer-generated)
  repairLoops    Int        @default(0)
  spendUsd       Float      @default(0)
  retentionScore Float?
  createdAt      DateTime   @default(now())
  beats          Beat[]
  screenings     Screening[]
  jobLogs        JobLog[]
  humanReactions HumanReaction[]

  @@unique([showId, number, arm])
}

model Beat {
  id            String   @id @default(cuid())
  episodeId     String
  episode       Episode  @relation(fields: [episodeId], references: [id])
  index         Int
  type          String // HOOK|SETUP|ESCALATION|REVEAL|TWIST|CONFLICT|BREATH|CLIFFHANGER
  title         String
  payload       String // JSON: full Beat contract
  compileStatus String?
  renderStatus  String   @default("PENDING") // PENDING|STILL|CARD|VIDEO|FAILED|SKIPPED
  stillPath     String?
  videoPath     String?
  audioPath     String?
  estCostUsd    Float    @default(0)
  engagement    Float?
  dropCount     Int      @default(0)
}

model Viewer {
  id         String       @id @default(cuid())
  showId     String
  show       Show         @relation(fields: [showId], references: [id])
  name       String
  archetype  String
  persona    String // JSON ViewerPersona
  seed       Int
  memories   ViewerMemory[]
  screenings Screening[]
}

model ViewerMemory {
  id         String   @id @default(cuid())
  viewerId   String
  viewer     Viewer   @relation(fields: [viewerId], references: [id])
  arm        String   @default("A") // parallel-timeline memory: each arm has its own continuity
  key        String
  content    String
  stability  Float    @default(0.5) // FSRS-inspired: grows on re-exposure
  lastSeenEp Int      @default(1)
  lastSeenAt DateTime @default(now())

  @@unique([viewerId, arm, key])
}

model Screening {
  id           String  @id @default(cuid())
  episodeId    String
  episode      Episode @relation(fields: [episodeId], references: [id])
  viewerId     String
  viewer       Viewer  @relation(fields: [viewerId], references: [id])
  seed         Int
  keepWatching Boolean
  dropAtBeat   Int?
  satisfaction Float
  events       String // JSON [{beat, s, S, recalled}]
  comment      String?
  sentiment    String? // POSITIVE|NEUTRAL|NEGATIVE

  @@unique([episodeId, viewerId])
}

model Experiment {
  id        String @id @default(cuid())
  showId    String
  show      Show   @relation(fields: [showId], references: [id])
  epNumber  Int // episode the chosen variant is used in
  slotIndex Int
  variantA  String // JSON Beat
  variantB  String // JSON Beat
  rewardA   Float?
  rewardB   Float?
  chosen    String? // 'A' | 'B'
  evidence  String? // JSON {n, alpha, beta, rationale}

  @@unique([showId, epNumber, slotIndex])
}

model CostEntry {
  id        String   @id @default(cuid())
  showId    String
  show      Show     @relation(fields: [showId], references: [id])
  episodeId String?
  stage     String // BIBLE|WRITER|RENDER|AUDIENCE|ANALYTICS|OPTIMIZER
  model     String
  kind      String // LLM|IMAGE|VIDEO|TTS
  tokens    Int      @default(0)
  costUsd   Float
  createdAt DateTime @default(now())
}

model JobLog {
  id        String   @id @default(cuid())
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id])
  showId    String?
  step      String
  status    String // STARTED|OK|WARN|ERROR
  detail    String?
  createdAt DateTime @default(now())
}

model WhatIfRun {
  id           String   @id @default(cuid())
  showId       String
  show         Show     @relation(fields: [showId], references: [id])
  arm          String   // 'A' | 'B'
  epNumber     Int      // the episode the simulated plan targets
  cohort       String?  // non-null = graded through a cohort lens (not gate-eligible)
  grade        String   // STRONG | PROMISING | MIXED | WEAK
  keepRate     Float
  deltaPts     Float
  beatCount    Int
  fingerprint  String   // sha256 over (showId, arm, epNumber, briefFp, beats)
  briefFp      String   // the brief fingerprint the plan was graded against
  planJson     String   // JSON Beat[] — the exact plan that was simulated
  createdAt    DateTime @default(now())

  @@index([showId, arm, epNumber])
}

model HumanReaction {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id])
  name      String
  rating    Int // 1-5 stars from a real human watching the player
  comment   String?
  sentiment String // POSITIVE|NEUTRAL|NEGATIVE (derived from rating)
  createdAt DateTime @default(now())
}
